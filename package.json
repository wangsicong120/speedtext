{
  "name": "speedtext",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "Privacy-conscious network testing with a native frontend and Cloudflare Workers API",
  "license": "Apache-2.0",
  "engines": { "node": "^22.23.0 || ^24.22.0 || ^26.12.0" },
  "scripts": {
    "dev": "cf dev",
    "dev:local": "node scripts/dev-server.js",
    "check": "node scripts/check.js",
    "test": "node --test tests/unit/*.test.js",
    "test:runtime": "npm run build && node --test tests/runtime/*.test.js",
    "test:e2e": "npm run build:static && playwright test",
    "build": "cf build && node scripts/check-build.js",
    "build:static": "vite build --config vite.static.config.js",
    "verify": "npm run check && npm test && npm run test:runtime && npm run test:e2e && npm run deploy:check",
    "deploy:check": "cf deploy --dry-run && node scripts/check-build.js",
    "deploy": "cf deploy"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@cloudflare/vite-plugin": "2.0.0-beta.v.14",
    "@playwright/test": "1.65.0",
    "cf": "1.0.0-beta.28",
    "miniflare": "5.20261110.0-beta",
    "vite": "8.3.7"
  }
}
